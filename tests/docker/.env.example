# QR Menu Suite — izole Docker test ortamı ayarları.
# Kopyala: cp tests/docker/.env.example tests/docker/.env
# Bunlar SADECE yerel/izole test ortamı için sahte değerlerdir;
# canlı site, cPanel veya gerçek müşteri verisiyle hiçbir ilgisi yoktur.

MYSQL_ROOT_PASSWORD=root_test_pw
WORDPRESS_DB_NAME=qrms_test
WORDPRESS_DB_USER=qrms_test
WORDPRESS_DB_PASSWORD=qrms_test_pw

WORDPRESS_PORT=8080

WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=QR Menu Suite Test
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_test_pw
WP_ADMIN_EMAIL=admin@example.test
